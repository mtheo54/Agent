{
  // Copie ce fichier en companion.json à côté de CompanionAI.exe. Toutes les clés sont optionnelles.
  "name": "Omnis",
  "tone": 2,
  "neuralVoice": true,
  "voiceQuirks": 0.5,
  "neuralVoiceInGame": false,
  "neuralVoiceDevice": "",

  // Cerveau local : Qwen3.5 9B (dépôt unsloth/Qwen3.5-9B-GGUF). Il voit aussi l'écran avec son projecteur :
  //   "llmMmproj": "assets/models/mmproj-F16.gguf",
  // PC plus modeste : Qwen3.5-4B-Q4_K_M.gguf (~2,7 Go).
  "llmModel": "assets/models/Qwen3.5-9B-Q4_K_M.gguf",
  // En jeu : petit modèle sur CPU, chargé seulement si tu lui parles (unsloth/Qwen3.5-2B-GGUF).
  "llmGamingModel": "assets/models/Qwen3.5-2B-Q4_K_M.gguf",
  // En jeu, l'avatar : 0 caché, 1 seulement quand il parle ou t'écoute, 2 toujours.
  "avatarInGame": 1,
  // En jeu : confiné au dernier cœur, priorité et mémoire basses (le jeu garde le reste).
  "gameIsolation": true,
  "llmContext": 4096,
  "llmThreads": 4,
  "llmThreadsGaming": 2,
  "llmUnloadAfterMinutes": 10,

  // Auto-entraînement pendant l'inactivité (processus isolé, tué dès que tu reviens).
  "autoTraining": true,
  "autoTrainingEveryMinutes": 120,
  "trainerMemoryLimitMb": 6144,

  // Studio : capture ciblée sur ce processus, alertes niveau 0 (clipping, phase).
  "studioProcess": "FL64.exe",
  "studioAlerts": true,

  // Applis lançables à la voix ("lance spotify"). target : chemin complet, commande ou URI.
  "apps": [
    { "name": "fl studio", "aliases": ["fl"], "target": "C:\\Program Files\\Image-Line\\FL Studio 2025\\FL64.exe" },
    { "name": "spotify", "target": "spotify:" },
    { "name": "discord", "target": "discord://" },
    { "name": "steam", "target": "steam://open/main" },
    { "name": "league of legends", "aliases": ["lol", "league"],
      "target": "C:\\Riot Games\\Riot Client\\RiotClientServices.exe",
      "args": "--launch-product=league_of_legends --launch-patchline=live" },
    { "name": "cyberpunk", "target": "steam://rungameid/1091500" }
  ],

  // Recherche web locale (liste blanche) et cache des connaissances apprises.
  "knowledgeMaxAgeDays": 14,
  "userAgent": "CompanionAI/0.3 (desktop assistant)",
  "wikis": [
    { "host": "leagueoflegends.fandom.com", "apiPath": "/api.php",
      "keywords": ["lol", "league", "champion", "build", "stuff", "item", "objet", "rune", "matchup"] },
    { "host": "cyberpunk.fandom.com", "apiPath": "/api.php",
      "keywords": ["cyberpunk", "night city", "quête", "mission", "johnny"] },
    { "host": "fr.wikipedia.org", "apiPath": "/w/api.php", "keywords": [] }
  ],

  // Dernier recours.
  "cloudEnabled": true,
  "cloudAsksPermission": true,
  "claudeModel": "claude-opus-5-5",
  "claudeEffort": "medium"
}
